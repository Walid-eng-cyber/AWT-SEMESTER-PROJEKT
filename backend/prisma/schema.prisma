generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum AppointmentStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

model Room {
  id          String        @id @default(cuid())
  name        String
  location    String
  capacity    Int
  equipment   String[]
  status      RoomStatus    @default(AVAILABLE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  appointments Appointment[]

  @@index([location])
  @@index([status])
}

model User {
  id        String        @id
  email     String        @unique
  passwordHash String?
  fullName  String
  role      String
  status    String        @default("active")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  appointments Appointment[]
  notifications Notification[]

  @@index([role])
  @@index([status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

model Appointment {
  id          String            @id @default(cuid())
  ownerUserId String
  title       String
  description String?
  roomId      String
  startsAt    DateTime
  endsAt      DateTime
  participants String[]
  status      AppointmentStatus @default(DRAFT)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  owner User @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)

  @@index([roomId])
  @@index([ownerUserId])
  @@index([startsAt, endsAt])
}
